{
  "name": "yui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "build:yandex": "tsc --noEmit && vite build --mode yandex --outDir dist-yandex",
    "build:server": "esbuild server/main.ts --bundle --platform=node --target=node20 --format=cjs --outfile=dist-server/server.cjs",
    "server": "npm run build:server && node dist-server/server.cjs",
    "release:yandex": "python scripts/release-yandex.py"
  },
  "dependencies": {
    "@fontsource/balsamiq-sans": "^5.3.0",
    "peerjs": "^1.5.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.2",
    "playwright": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^4.1.11"
  }
}
